---
import Base from "../layouts/Base.astro";
import { PAGES } from "../lib/site";

const main = PAGES.filter((p) => !p.footerOnly);
---

<Base path="/404" notFound>
  <header class="page-head">
    <p class="kicker">Error 404</p>
    <h1>No page at this address</h1>
    <p class="lede">
      The link may be mistyped, or the page may have moved. OpsPilot would escalate this to a human; here is the next
      best thing.
    </p>
  </header>
  <section class="section" aria-labelledby="pages">
    <h2 id="pages">Pages on this site</h2>
    <ul class="prose">
      {main.map((p) => <li><a href={p.path}>{p.nav}</a>: {p.description}</li>)}
    </ul>
  </section>
</Base>
