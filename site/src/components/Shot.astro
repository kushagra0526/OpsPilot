---
// A real screenshot of the running app, served as responsive WebP with explicit dimensions.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  file: string;
  alt: string;
  number?: number;
  caption: string;
  eager?: boolean;
}
const { file, alt, number, caption, eager = false } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.png", { eager: true });
const entry = all[`../assets/screens/${file}`];
if (!entry) throw new Error(`screenshot not found: ${file}`);
---

<figure class="shot">
  <Image
    src={entry.default}
    alt={alt}
    widths={[720, 1080, 1440, 2160]}
    sizes="(min-width: 72rem) 67.5rem, calc(100vw - 2.5rem)"
    format="webp"
    quality={78}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
  <figcaption>{number && <span class="fig">Figure {number}</span>}{caption}</figcaption>
</figure>
