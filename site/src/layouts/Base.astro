---
// Page shell: head metadata (title, description, canonical, OG/Twitter, JSON-LD), header,
// breadcrumbs, footer. Every URL is built from SITE_URL via Astro.site.
import "../styles/global.css";
import { readFileSync } from "node:fs";
import path from "node:path";
import { AUTHOR, PAGES, absolute, page } from "../lib/site";
import { jsonLd, type Crumb } from "../lib/schema";
import { REPO } from "../lib/data";

interface Props {
  path: string;
  notFound?: boolean;
}
const { path: pagePath, notFound = false } = Astro.props;
const site = Astro.site!;
const meta = notFound
  ? {
      slug: "404",
      path: "/404",
      nav: "Not found",
      title: "Page not found | OpsPilot",
      description: "This address does not match a page on the OpsPilot project site.",
    }
  : page(pagePath);
const crumbs: Crumb[] =
  notFound || meta.path === "/"
    ? []
    : [
        { name: "Overview", path: "/" },
        { name: meta.nav, path: meta.path },
      ];
const canonical = absolute(site, meta.path);
const ogSlug = notFound ? "home" : meta.slug || "home";
const ogImage = absolute(site, `/og/${ogSlug}.png`);
const ogAlt = `OpsPilot: ${notFound ? "project site" : meta.nav}. Title card with a screenshot of the running app.`;
const mark = readFileSync(path.join(REPO, "brand", "mark.svg"), "utf8")
  .replace(/\srole="img"/, "")
  .replace(/\saria-label="[^"]*"/, "")
  .replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
const nav = PAGES.filter((p) => !p.footerOnly);
const ld = JSON.stringify(jsonLd(site, meta as never, crumbs));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="author" content={AUTHOR.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpsPilot" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><Fragment set:html={mark} /><span>OpsPilot</span></a>
        <nav class="nav" aria-label="Main">
          <ul>
            {
              nav.map((p) => (
                <li>
                  <a href={p.path} aria-current={p.path === meta.path ? "page" : undefined}>
                    {p.nav}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="content">
      <div class="wrap">
        {
          crumbs.length > 0 && (
            <nav class="crumbs" aria-label="Breadcrumb">
              <ol>
                {crumbs.map((c, i) => (
                  <li>
                    {i < crumbs.length - 1 ? (
                      <a href={c.path}>{c.name}</a>
                    ) : (
                      <span aria-current="page">{c.name}</span>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <h2>OpsPilot</h2>
          <p>
            A support-operations agent for NovaMart, a fictional store. Built by {AUTHOR.name}. All store data
            on this site and in the demo is invented.
          </p>
        </div>
        <div>
          <h2>Pages</h2>
          <ul>
            {PAGES.map((p) => <li><a href={p.path}>{p.nav}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Elsewhere</h2>
          <ul>
            <li><a href={AUTHOR.github} rel="me">GitHub profile</a></li>
            <li><a href={AUTHOR.linkedin} rel="me">LinkedIn</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
